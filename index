<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MyCalcium</title>
<style>
:root{
  --bg:#f6f8f5;--card:#fff;--text:#27302c;--muted:#747b78;
  --primary:#71c79a;--primary2:#86f000;--success:#66c58f;
  --warning:#86f000;--danger:#ef4444;--border:#dfe5e1;
  --shadow:0 8px 25px rgba(30,50,90,.08);--radius:19px;
}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text)}
.app{width:min(100%,480px);min-height:100vh;margin:auto;padding-bottom:86px;background:var(--bg)}
header{
  padding:25px 19px 22px;background:linear-gradient(135deg,#eef9f2,#f7fff0);
  border-radius:0 0 28px 28px
}
.header-row{display:flex;align-items:center;justify-content:space-between}
.brand{font-weight:850;font-size:28px;color:#4fae7b;letter-spacing:-.7px}
.tagline{font-size:13px;color:var(--muted);margin-top:3px}
.profile{width:43px;height:43px;background:white;border-radius:50%;display:grid;place-items:center;font-weight:800;color:#63bd8a;box-shadow:var(--shadow)}
main{padding:16px}
.card{background:var(--card);border-radius:var(--radius);padding:17px;margin-bottom:15px;box-shadow:var(--shadow)}
h3{margin:0 0 13px;font-size:17px}
.today{display:flex;gap:17px;align-items:center}
.ring{
  --p:0;width:118px;height:118px;border-radius:50%;flex:none;
  background:conic-gradient(var(--primary) calc(var(--p)*1%),#e5e7eb 0);
  display:grid;place-items:center;position:relative
}
.ring:after{content:"";position:absolute;width:85px;height:85px;border-radius:50%;background:white}
.ring-inner{z-index:1;text-align:center}.ring-inner b{font-size:23px;display:block}.ring-inner span{font-size:10px;color:var(--muted)}
.big{font-size:26px;font-weight:850}.small{font-size:12px;color:var(--muted)}
.remaining{margin-top:12px;padding:10px 12px;border-radius:12px;background:#eef9f2;color:#4fae7b;font-size:13px;font-weight:700}
.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}
label.field{font-size:11px;color:var(--muted);font-weight:650}
input,textarea,select{
  width:100%;border:1px solid var(--border);border-radius:12px;padding:11px;margin-top:5px;
  font:inherit;color:var(--text);background:white;outline:none
}
textarea{min-height:72px;resize:vertical}
input:focus,textarea:focus,select:focus{border-color:#93c5fd}
.segment{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px}
.segment button,.range-tabs button{
  border:0;border-radius:11px;padding:9px;background:#edf1f7;color:#475569;font-weight:750;cursor:pointer
}
.segment button.active,.range-tabs button.active{background:var(--primary);color:white}
.photo{display:none;border:1.5px dashed #71c79a;background:#f8fcf9;border-radius:13px;padding:22px;text-align:center;color:#63bd8a;cursor:pointer}
.photo input{display:none}
.btn{border:0;border-radius:13px;padding:12px 13px;font-weight:800;cursor:pointer}
.btn-primary{background:var(--primary);color:white;width:100%;margin-top:11px}
.btn-secondary{background:#eef9f2;color:#3f7659}
.btn-danger{background:#fff4f4;color:#a94747}
.meal{padding:12px 0;border-bottom:1px solid var(--border);display:flex;justify-content:space-between;gap:12px}
.meal:last-child{border-bottom:0}.meal b{font-size:14px}.meal-desc{font-size:12px;color:var(--muted);margin-top:3px;max-width:265px}
.meal-right{text-align:right;white-space:nowrap;font-size:12px}.meal-right strong{font-size:14px;display:block}.meal-actions{margin-top:5px}
.linkbtn{border:0;background:none;padding:0;color:#b34d4d;font-size:11px;cursor:pointer}
.range-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:5px;margin-bottom:12px}
.range-tabs button{font-size:11px;padding:8px 3px}
.period-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-end;margin-bottom:10px}
.period-head b{font-size:21px}.period-head span{display:block;font-size:11px;color:var(--muted);margin-top:2px}
.chart-box{height:230px;border:1px solid var(--border);border-radius:14px;padding:8px;background:#fbfdff}
canvas{width:100%;height:100%}
.summary-grid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.stats{display:grid;grid-template-columns:repeat(2,1fr);gap:8px;margin-top:11px}
.stat{background:#f8fafc;border:1px solid var(--border);border-radius:12px;padding:10px}
.stat b{font-size:17px;display:block}.stat span{font-size:11px;color:var(--muted)}
.goal-line{font-size:11px;color:var(--muted);margin-top:9px}
.empty{text-align:center;color:var(--muted);font-size:13px;padding:18px 8px}
.goal-edit{display:flex;gap:7px}.goal-edit input{margin:0}.goal-edit button{white-space:nowrap}
.data-tools{display:flex;gap:7px;margin-top:11px}.data-tools button{flex:1;font-size:11px}
nav{
 position:fixed;left:50%;transform:translateX(-50%);bottom:0;width:min(100%,480px);z-index:20;
 background:white;border-top:1px solid var(--border);display:grid;grid-template-columns:repeat(4,1fr);padding:9px 4px 11px
}
nav button{border:0;background:none;color:var(--muted);font-size:10px}nav span{display:block;font-size:20px;margin-bottom:2px}nav .active{color:var(--primary);font-weight:800}
.toast{
 display:none;position:fixed;left:50%;transform:translateX(-50%);bottom:86px;width:min(90%,420px);
 background:#111827;color:white;border-radius:12px;padding:11px 13px;text-align:center;font-size:13px;z-index:50
}
.note{font-size:11px;color:var(--muted);line-height:1.45;margin-top:8px}
@media(max-width:360px){.today{gap:11px}.ring{width:106px;height:106px}.ring:after{width:76px;height:76px}.big{font-size:22px}}

.login-screen{position:fixed;inset:0;z-index:1000;background:linear-gradient(135deg,#eef9f2,#fbfff6);display:flex;align-items:center;justify-content:center;padding:22px}
.login-card{width:min(100%,410px);background:white;border-radius:24px;padding:26px;box-shadow:0 20px 55px rgba(84,150,111,.16)}
.login-logo{font-size:32px;font-weight:900;color:#4fae7b;letter-spacing:-.8px}
.login-sub{font-size:14px;color:#6b7280;margin:5px 0 22px}
.login-card label{display:block;font-size:12px;color:#64748b;font-weight:700;margin-bottom:6px}
.login-card input{width:100%;border:1px solid #dbe2ea;border-radius:13px;padding:13px 14px;font:inherit;outline:none}
.login-card input:focus{border-color:#71c79a;box-shadow:0 0 0 3px rgba(113,199,154,.16)}
.login-btn{width:100%;border:0;border-radius:13px;padding:13px;margin-top:12px;background:#71c79a;color:white;font-weight:800;cursor:pointer}
.login-error{display:none;color:#b91c1c;background:#fef2f2;border-radius:10px;padding:9px 10px;font-size:12px;margin-top:10px}
.login-note{font-size:11px;color:#94a3b8;line-height:1.45;margin-top:12px}
.logout-btn{border:0;background:white;color:#63bd8a;border-radius:11px;padding:8px 10px;font-weight:750;box-shadow:0 4px 14px rgba(84,150,111,.10);cursor:pointer;font-size:11px}
.user-email{font-size:10px;color:#64748b;margin-top:3px;max-width:140px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;text-align:right}

.ciro-logo-login{
  display:block;width:150px;max-height:105px;object-fit:contain;margin:0 auto 8px;
}
.ciro-logo-header{
  width:54px;height:42px;object-fit:contain;background:white;border-radius:10px;padding:3px;
}
.brand-wrap{display:flex;align-items:center;gap:10px}
.brand-accent{color:#86f000}
</style>
</head>
<body>
<div id="loginScreen" class="login-screen">
  <div class="login-card">
    <img class="ciro-logo-login" src="data:image/jpeg;base64," alt="CIRO"><div class="login-logo">My<span class="brand-accent">Calcium</span></div>
    <div class="login-sub">Tu calcio diario, más claro.</div>
    <label for="loginEmail">Correo electrónico</label>
    <input id="loginEmail" type="email" inputmode="email" autocomplete="email" placeholder="nombre@correo.com">
    <button class="login-btn" onclick="simpleLogin()">Ingresar</button>
    <div id="loginError" class="login-error">Ingresa un correo electrónico válido.</div>
    <div class="login-note">Prototipo: el correo se valida únicamente por su formato y la sesión se guarda en este navegador. La verificación real mediante enlace enviado al correo se añadirá en una siguiente versión.</div>
  </div>
</div>

<div class="app">
<header>
  <div class="header-row">
    <div class="brand-wrap">
      <img class="ciro-logo-header" src="data:image/jpeg;base64," alt="CIRO">
      <div><div class="brand">My<span class="brand-accent">Calcium</span></div><div class="tagline">Tu calcio diario, más claro.</div></div>
    </div>
    <div style="display:flex;align-items:center;gap:8px"><div><button class="logout-btn" onclick="logout()">Salir</button><div id="headerEmail" class="user-email"></div></div><div class="profile">MC</div></div>
  </div>
</header>

<main>
<section class="card">
  <h3>Perfil del usuario</h3>
  <div class="form-grid">
    <label class="field">Sexo
      <select id="sexInput" onchange="updateRecommendedGoal()">
        <option value="">Seleccionar</option>
        <option value="female">Mujer</option>
        <option value="male">Hombre</option>
      </select>
    </label>
    <label class="field">Fecha de nacimiento
      <input id="birthInput" type="date" onchange="updateRecommendedGoal()">
    </label>
  </div>
  <div id="ageInfo" class="note" style="margin-top:10px">Completa sexo y fecha de nacimiento para calcular la meta diaria.</div>
  <div id="iofRecommendation" class="remaining" style="display:none"></div>
</section>

<section class="card">
  <div class="period-head">
    <div><h3 style="margin-bottom:2px">Calcio de hoy</h3><span id="todayDate"></span></div>
    <div style="text-align:right"><span>Meta</span><b id="goalLabel">1,200 mg</b></div>
  </div>
  <div class="today">
    <div class="ring" id="ring"><div class="ring-inner"><b id="todayCalcium">0</b><span>mg consumidos</span></div></div>
    <div>
      <div class="small">Calorías registradas</div><div class="big" id="todayCalories">0 kcal</div>
      <div class="small" style="margin-top:8px">Cumplimiento</div><div class="big" id="todayPercent">0%</div>
    </div>
  </div>
  <div class="remaining" id="remaining">Registra tu primera comida de hoy.</div>
</section>

<section class="card">
  <h3>Registrar consumo</h3>
  <div class="segment">
    <button id="textTab" class="active" onclick="setMode('text')">✍️ Texto</button>
    <button id="photoTab" onclick="setMode('photo')">📷 Foto</button>
  </div>

  <div id="textMode">
    <label class="field">¿Qué comiste?
      <textarea id="foodText" placeholder="Ej. Un vaso de leche, yogurt natural y dos tortillas"></textarea>
    </label>
  </div>

  <label id="photoMode" class="photo">
    <div style="font-size:32px">📸</div>
    <b>Tomar o elegir foto</b>
    <div class="small" style="margin-top:5px">Prototipo de reconocimiento por IA</div>
    <input id="photoInput" type="file" accept="image/*" capture="environment">
  </label>

  <button class="btn btn-secondary" style="width:100%;margin-top:10px" onclick="estimateFood()">✨ Estimar automáticamente</button>

  <div id="estimateCard" style="display:none;margin-top:10px;padding:12px;border:1px solid var(--border);border-radius:13px;background:#f8fafc">
    <div style="font-size:12px;color:var(--muted);font-weight:700;margin-bottom:8px">Estimación nutricional</div>
    <div id="detectedFoods" style="font-size:13px;line-height:1.55"></div>
    <div class="summary-grid" style="margin-top:10px">
      <div class="stat"><b id="estimateCalcium">0 mg</b><span>Calcio estimado</span></div>
      <div class="stat"><b id="estimateCalories">0 kcal</b><span>Calorías estimadas</span></div>
    </div>
  </div>

  <div class="form-grid" style="margin-top:10px">
    <label class="field">Calcio calculado (mg)
      <input id="calciumInput" type="number" min="0" step="1" placeholder="Automático">
    </label>
    <label class="field">Calorías calculadas
      <input id="calorieInput" type="number" min="0" step="1" placeholder="Automático">
    </label>
  </div>

  <div class="form-grid" style="margin-top:9px">
    <label class="field">Fecha
      <input id="dateInput" type="date">
    </label>
    <label class="field">Momento
      <select id="mealType">
        <option>Desayuno</option><option>Colación</option><option>Comida</option>
        <option>Cena</option><option>Suplemento</option><option>Otro</option>
      </select>
    </label>
  </div>
  <button class="btn btn-primary" onclick="addEntry()">Guardar registro</button>
  <div class="note">Escribe lo que comiste y pulsa “Estimar automáticamente”. El prototipo reconoce alimentos frecuentes y calcula calcio y calorías. Los valores pueden corregirse antes de guardar.</div>
</section>

<section class="card">
  <div class="period-head">
    <div><h3 style="margin-bottom:2px">Historial y gráficas</h3><span>Consumo de calcio</span></div>
  </div>
  <div class="range-tabs">
    <button class="active" data-range="day" onclick="setRange('day',this)">Diario</button>
    <button data-range="week" onclick="setRange('week',this)">Semanal</button>
    <button data-range="month" onclick="setRange('month',this)">Mensual</button>
    <button data-range="year" onclick="setRange('year',this)">Anual</button>
  </div>

  <div class="chart-box"><canvas id="chart"></canvas></div>
  <div class="goal-line">La línea punteada representa la meta proporcional del periodo.</div>
  <div class="stats">
    <div class="stat"><b id="statTotal">0 mg</b><span>Calcio total</span></div>
    <div class="stat"><b id="statAverage">0 mg</b><span id="avgLabel">Promedio diario</span></div>
    <div class="stat"><b id="statGoal">0%</b><span>Cumplimiento</span></div>
    <div class="stat"><b id="statDeficit">0 mg</b><span>Déficit promedio diario</span></div>
  </div>
</section>

<section class="card">
  <h3>Registros de hoy</h3>
  <div id="mealList"></div>
</section>

<section class="card">
  <h3>Configuración</h3>
  <label class="field">Meta diaria de calcio (mg)</label>
  <div class="goal-edit">
    <input id="goalInput" type="number" min="100" step="50" value="1200">
    <button class="btn btn-secondary" onclick="saveGoal()">Ajuste médico</button>
  </div>
  <div class="note">La meta se calcula automáticamente con edad y sexo usando la tabla de ingesta diaria de calcio publicada por IOF (IOM/NAM). El médico puede modificarla cuando exista una indicación clínica individual.</div>
  <div class="data-tools">
    <button class="btn btn-secondary" onclick="seedDemo()">Cargar datos de ejemplo</button>
    <button class="btn btn-danger" onclick="clearData()">Borrar datos</button>
  </div>
  <div class="note">Los datos quedan guardados localmente en este navegador mediante localStorage.</div>
</section>
</main>

<nav>
  <button class="active"><span>🏠</span>Inicio</button>
  <button><span>➕</span>Registrar</button>
  <button><span>📊</span>Gráficas</button>
  <button><span>👤</span>Perfil</button>
</nav>
<div id="toast" class="toast"></div>
</div>

<script>
const AUTHKEY='mycalcium_simple_auth_v1';
function validEmail(email){return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(String(email).trim());}
function simpleLogin(){
  const email=$('loginEmail').value.trim().toLowerCase(), error=$('loginError');
  if(!validEmail(email)){error.style.display='block';return;}
  error.style.display='none';
  localStorage.setItem(AUTHKEY,JSON.stringify({email,loggedIn:true}));
  showAppForUser(email);
}
function showAppForUser(email){$('loginScreen').style.display='none';$('headerEmail').textContent=email||'';}
function logout(){localStorage.removeItem(AUTHKEY);$('loginEmail').value='';$('headerEmail').textContent='';$('loginScreen').style.display='flex';}
function initAuth(){
  let auth=null;
  try{auth=JSON.parse(localStorage.getItem(AUTHKEY)||'null')}catch(e){}
  if(auth && auth.loggedIn && validEmail(auth.email)) showAppForUser(auth.email);
  else $('loginScreen').style.display='flex';
}

const KEY='mycalcium_entries_v2', GOALKEY='mycalcium_goal_v2', PROFILEKEY='mycalcium_profile_v1', OVERRIDEKEY='mycalcium_goal_override_v1';
let entries=JSON.parse(localStorage.getItem(KEY)||'[]');
let goal=Number(localStorage.getItem(GOALKEY)||1200);
let profile=JSON.parse(localStorage.getItem(PROFILEKEY)||'{}');
let manualOverride=localStorage.getItem(OVERRIDEKEY)==='true';
let mode='text', range='day';

const $=id=>document.getElementById(id);
const iso=d=>{const y=d.getFullYear(),m=String(d.getMonth()+1).padStart(2,'0'),da=String(d.getDate()).padStart(2,'0');return `${y}-${m}-${da}`};
const parseDate=s=>{const [y,m,d]=s.split('-').map(Number);return new Date(y,m-1,d)};
const fmt=n=>Math.round(n).toLocaleString('es-MX');

function showToast(msg){const t=$('toast');t.textContent=msg;t.style.display='block';setTimeout(()=>t.style.display='none',2300)}
function save(){localStorage.setItem(KEY,JSON.stringify(entries))}
function setMode(m){
 mode=m;$('textMode').style.display=m==='text'?'block':'none';$('photoMode').style.display=m==='photo'?'block':'none';
 $('textTab').classList.toggle('active',m==='text');$('photoTab').classList.toggle('active',m==='photo');
}
function todayEntries(){const t=iso(new Date());return entries.filter(e=>e.date===t)}
function sum(arr,k){return arr.reduce((a,e)=>a+Number(e[k]||0),0)}
function calculateAge(birth){
 if(!birth) return null;
 const b=parseDate(birth), now=new Date();
 let age=now.getFullYear()-b.getFullYear();
 const m=now.getMonth()-b.getMonth();
 if(m<0 || (m===0 && now.getDate()<b.getDate())) age--;
 return age;
}

function iofCalciumGoal(age,sex){
 if(age===null || age<0) return null;
 if(age<0.5) return 200;
 if(age<1) return 260;
 if(age<=3) return 700;
 if(age<=8) return 1000;
 if(age<=18) return 1300;
 if(age<=50) return 1000;
 if(age<=70) return sex==='female' ? 1200 : (sex==='male' ? 1000 : null);
 return 1200;
}

function updateRecommendedGoal(force=true){
 const sex=$('sexInput').value, birth=$('birthInput').value;
 profile={sex,birth};
 localStorage.setItem(PROFILEKEY,JSON.stringify(profile));
 const age=calculateAge(birth);
 if(age===null || !sex){
   $('ageInfo').textContent='Completa sexo y fecha de nacimiento para calcular la meta diaria.';
   $('iofRecommendation').style.display='none';
   return;
 }
 $('ageInfo').textContent=`Edad calculada: ${age} años · ${sex==='female'?'Mujer':'Hombre'}.`;
 const rec=iofCalciumGoal(age,sex);
 if(rec){
   if(force || !manualOverride){
     goal=rec;
     manualOverride=false;
     localStorage.setItem(OVERRIDEKEY,'false');
     localStorage.setItem(GOALKEY,String(goal));
   }
   $('iofRecommendation').style.display='block';
   $('iofRecommendation').textContent=`Meta recomendada: ${fmt(rec)} mg de calcio al día según edad y sexo (tabla IOF / IOM-NAM).`;
   $('goalInput').value=goal;
   renderToday(); renderChart();
 }
}

function saveGoal(){
 const g=Number($('goalInput').value);
 if(!g||g<100){showToast('Introduce una meta válida.');return}
 goal=g;manualOverride=true;localStorage.setItem(OVERRIDEKEY,'true');localStorage.setItem(GOALKEY,String(goal));render();showToast('Meta ajustada manualmente por criterio médico.');
}
const foodDB=[
 {keys:['leche','vaso de leche'],unit:'vaso',ca:300,kcal:150,defaultQty:1},
 {keys:['yogurt','yoghurt','yogur'],unit:'pieza',ca:250,kcal:150,defaultQty:1},
 {keys:['queso'],unit:'porción',ca:200,kcal:120,defaultQty:1},
 {keys:['tortilla','tortillas'],unit:'pieza',ca:45,kcal:60,defaultQty:1},
 {keys:['huevo','huevos'],unit:'pieza',ca:28,kcal:72,defaultQty:1},
 {keys:['almendras'],unit:'30 g',ca:75,kcal:170,defaultQty:1},
 {keys:['sardinas'],unit:'porción',ca:325,kcal:190,defaultQty:1},
 {keys:['frijoles'],unit:'taza',ca:80,kcal:230,defaultQty:1},
 {keys:['espinaca'],unit:'taza cocida',ca:245,kcal:40,defaultQty:1},
 {keys:['brócoli','brocoli'],unit:'taza',ca:60,kcal:55,defaultQty:1},
 {keys:['tofu'],unit:'porción',ca:250,kcal:145,defaultQty:1},
 {keys:['jugo de naranja fortificado'],unit:'vaso',ca:300,kcal:110,defaultQty:1},
 {keys:['pan'],unit:'rebanada',ca:30,kcal:80,defaultQty:1},
 {keys:['pollo'],unit:'porción',ca:15,kcal:250,defaultQty:1},
 {keys:['arroz'],unit:'taza',ca:20,kcal:205,defaultQty:1},
 {keys:['café','cafe'],unit:'taza',ca:5,kcal:5,defaultQty:1},
 {keys:['manzana'],unit:'pieza',ca:10,kcal:95,defaultQty:1},
 {keys:['plátano','platano'],unit:'pieza',ca:6,kcal:105,defaultQty:1}
];

const numberWords={un:1,una:1,uno:1,dos:2,tres:3,cuatro:4,cinco:5,seis:6,siete:7,ocho:8,nueve:9,diez:10,medio:.5,media:.5};

function qtyNear(text,index){
 const before=text.slice(Math.max(0,index-25),index).toLowerCase();
 let m=before.match(/(\d+(?:[.,]\d+)?)\s*(?:vasos?|tazas?|piezas?|porciones?|rebanadas?)?\s*$/);
 if(m)return Number(m[1].replace(',','.'));
 const words=Object.keys(numberWords).join('|');
 m=before.match(new RegExp('('+words+')\\s*(?:vasos?|tazas?|piezas?|porciones?|rebanadas?)?\\s*$'));
 return m?numberWords[m[1]]:1;
}

function estimateFood(){
 const text=$('foodText').value.trim().toLowerCase();
 const hasPhoto=$('photoInput').files.length>0;
 if(mode==='photo' && hasPhoto){
   showToast('En el prototipo HTML la foto requiere conexión a IA. Usa texto para probar el cálculo automático.');
   return;
 }
 if(!text){showToast('Escribe lo que comiste para estimarlo.');return}
 let found=[], totalCa=0,totalKcal=0;
 for(const food of foodDB){
   let match=null,key='';
   for(const k of food.keys){const i=text.indexOf(k);if(i>=0){match=i;key=k;break}}
   if(match!==null){
     const q=qtyNear(text,match);
     const ca=Math.round(food.ca*q), kcal=Math.round(food.kcal*q);
     totalCa+=ca;totalKcal+=kcal;
     found.push(`${q} × ${key} ≈ ${ca} mg Ca · ${kcal} kcal`);
   }
 }
 if(!found.length){
   $('estimateCard').style.display='block';
   $('detectedFoods').innerHTML='No pude reconocer alimentos de la base local. En la versión conectada a IA se analizaría el texto libre completo.';
   $('estimateCalcium').textContent='—';$('estimateCalories').textContent='—';
   showToast('No se reconocieron alimentos en la base del prototipo.');
   return;
 }
 $('calciumInput').value=totalCa;$('calorieInput').value=totalKcal;
 $('estimateCalcium').textContent=fmt(totalCa)+' mg';
 $('estimateCalories').textContent=fmt(totalKcal)+' kcal';
 $('detectedFoods').innerHTML=found.map(x=>'• '+x).join('<br>');
 $('estimateCard').style.display='block';
 showToast('Estimación automática realizada.');
}

function addEntry(){
 const date=$('dateInput').value||iso(new Date());
 const text=$('foodText').value.trim();
 const hasPhoto=$('photoInput').files.length>0;
 if(!Number($('calciumInput').value) && !Number($('calorieInput').value) && text){estimateFood();}
 const ca=Number($('calciumInput').value), kcal=Number($('calorieInput').value);
 if(!ca && !kcal){showToast('No pude calcular el registro. Pulsa “Estimar automáticamente”.');return}
 let desc=text || (hasPhoto?'Fotografía de alimento':'Registro manual');
 entries.push({id:Date.now(),date,meal:$('mealType').value,description:desc,calcium:ca||0,calories:kcal||0,createdAt:new Date().toISOString()});
 save();$('foodText').value='';$('calciumInput').value='';$('calorieInput').value='';$('photoInput').value='';$('estimateCard').style.display='none';
 render();showToast('Consumo guardado.');
}
function removeEntry(id){entries=entries.filter(e=>e.id!==id);save();render();showToast('Registro eliminado.')}
function renderToday(){
 const es=todayEntries(), ca=sum(es,'calcium'), kcal=sum(es,'calories'), pct=goal?Math.round(ca/goal*100):0;
 $('todayCalcium').textContent=fmt(ca);$('todayCalories').textContent=fmt(kcal)+' kcal';$('todayPercent').textContent=pct+'%';
 $('ring').style.setProperty('--p',Math.min(pct,100));$('goalLabel').textContent=fmt(goal)+' mg';
 const rem=Math.max(goal-ca,0);
 $('remaining').textContent=ca===0?'Registra tu primera comida de hoy.':rem>0?`Te faltan aproximadamente ${fmt(rem)} mg de calcio para alcanzar tu meta.`:'¡Meta diaria de calcio alcanzada!';
 $('mealList').innerHTML=es.length?es.slice().sort((a,b)=>b.id-a.id).map(e=>`
 <div class="meal"><div><b>${e.meal}</b><div class="meal-desc">${escapeHtml(e.description)}</div></div>
 <div class="meal-right"><strong>${fmt(e.calcium)} mg Ca</strong><span>${fmt(e.calories)} kcal</span>
 <div class="meal-actions"><button class="linkbtn" onclick="removeEntry(${e.id})">Eliminar</button></div></div></div>`).join(''):'<div class="empty">No hay registros para hoy.</div>';
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function startOfWeek(d){let x=new Date(d);const day=(x.getDay()+6)%7;x.setDate(x.getDate()-day);x.setHours(0,0,0,0);return x}
function daysBetween(a,b){return Math.round((b-a)/86400000)}
function getSeries(){
 const now=new Date(), today=iso(now);
 if(range==='day'){
   const vals=[];
   for(let i=6;i>=0;i--){let d=new Date(now);d.setDate(d.getDate()-i);let ds=iso(d);vals.push({label:d.toLocaleDateString('es-MX',{weekday:'short'}).replace('.',''),value:sum(entries.filter(e=>e.date===ds),'calcium'),goal});}
   return {vals,days:7,avgLabel:'Promedio diario'};
 }
 if(range==='week'){
   const vals=[];
   const thisWeek=startOfWeek(now);
   for(let i=7;i>=0;i--){let s=new Date(thisWeek);s.setDate(s.getDate()-i*7);let e=new Date(s);e.setDate(e.getDate()+6);
     let filtered=entries.filter(x=>{let d=parseDate(x.date);return d>=s&&d<=e});
     vals.push({label:`S${8-i}`,value:sum(filtered,'calcium'),goal:goal*7});
   }
   return {vals,days:56,avgLabel:'Promedio diario'};
 }
 if(range==='month'){
   const vals=[];
   for(let i=11;i>=0;i--){let d=new Date(now.getFullYear(),now.getMonth()-i,1), y=d.getFullYear(),m=d.getMonth();
     let filtered=entries.filter(x=>{let q=parseDate(x.date);return q.getFullYear()===y&&q.getMonth()===m});
     const dim=new Date(y,m+1,0).getDate();
     vals.push({label:d.toLocaleDateString('es-MX',{month:'short'}).replace('.',''),value:sum(filtered,'calcium'),goal:goal*dim});
   }
   return {vals,days:365,avgLabel:'Promedio diario'};
 }
 const vals=[];
 const y=now.getFullYear();
 for(let i=4;i>=0;i--){let yr=y-i, filtered=entries.filter(x=>parseDate(x.date).getFullYear()===yr), leap=new Date(yr,1,29).getMonth()===1;
   vals.push({label:String(yr),value:sum(filtered,'calcium'),goal:goal*(leap?366:365)});
 }
 return {vals,days:vals.reduce((a,v)=>a+(new Date(Number(v.label),1,29).getMonth()===1?366:365),0),avgLabel:'Promedio diario'};
}
function setRange(r,btn){range=r;document.querySelectorAll('.range-tabs button').forEach(b=>b.classList.remove('active'));btn.classList.add('active');renderChart()}
function renderChart(){
 const c=$('chart'), rect=c.getBoundingClientRect(), dpr=window.devicePixelRatio||1;
 c.width=rect.width*dpr;c.height=rect.height*dpr;const ctx=c.getContext('2d');ctx.scale(dpr,dpr);
 const W=rect.width,H=rect.height,pad={l:39,r:10,t:13,b:30};ctx.clearRect(0,0,W,H);
 const {vals,days,avgLabel}=getSeries(), max=Math.max(...vals.map(v=>v.value),...vals.map(v=>v.goal),goal,1)*1.08;
 ctx.font='10px system-ui';ctx.fillStyle='#64748b';ctx.strokeStyle='#e5e7eb';ctx.lineWidth=1;
 for(let i=0;i<=4;i++){let y=pad.t+(H-pad.t-pad.b)*i/4;ctx.beginPath();ctx.moveTo(pad.l,y);ctx.lineTo(W-pad.r,y);ctx.stroke();let val=max*(1-i/4);ctx.fillText(Math.round(val/1000)+'k',5,y+3)}
 const plotW=W-pad.l-pad.r, plotH=H-pad.t-pad.b, step=plotW/vals.length, bw=Math.max(6,step*.55);
 vals.forEach((v,i)=>{
   let x=pad.l+i*step+(step-bw)/2, bh=(v.value/max)*plotH, y=H-pad.b-bh;
   const grad=ctx.createLinearGradient(0,y,0,H-pad.b);grad.addColorStop(0,'#86f000');grad.addColorStop(1,'#71c79a');
   ctx.fillStyle=grad;roundRect(ctx,x,y,bw,bh,5);ctx.fill();
   ctx.fillStyle='#64748b';ctx.textAlign='center';ctx.fillText(v.label,pad.l+i*step+step/2,H-10);
 });
 // proportional goal line, use latest unit goal for consistent visual comparison
 const lineGoal=vals[vals.length-1]?.goal||goal, gy=H-pad.b-(lineGoal/max)*plotH;
 ctx.setLineDash([5,4]);ctx.strokeStyle='#9b9b9b';ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(pad.l,gy);ctx.lineTo(W-pad.r,gy);ctx.stroke();ctx.setLineDash([]);
 ctx.textAlign='left';
 const total=sum(vals,'value'), dailyAvg=days?total/days:0, expected=goal*days, compliance=expected?Math.round(total/expected*100):0, deficit=Math.max(goal-dailyAvg,0);
 $('statTotal').textContent=fmt(total)+' mg';$('statAverage').textContent=fmt(dailyAvg)+' mg';$('avgLabel').textContent=avgLabel;
 $('statGoal').textContent=compliance+'%';$('statDeficit').textContent=fmt(deficit)+' mg';
}
function roundRect(ctx,x,y,w,h,r){if(h<1)return;const rr=Math.min(r,w/2,h/2);ctx.beginPath();ctx.moveTo(x+rr,y);ctx.arcTo(x+w,y,x+w,y+h,rr);ctx.arcTo(x+w,y+h,x,y+h,rr);ctx.arcTo(x,y+h,x,y,rr);ctx.arcTo(x,y,x+w,y,rr);ctx.closePath()}
function seedDemo(){
 if(entries.length && !confirm('Esto agregará datos de demostración a tus registros actuales. ¿Continuar?'))return;
 const foods=['Leche y desayuno','Yogurt','Comida con queso','Cena','Suplemento','Tortillas y frijoles'];
 for(let i=0;i<370;i++){
   let d=new Date();d.setDate(d.getDate()-i);
   const base=650+Math.round(Math.random()*500);
   if(Math.random()>.08){
     entries.push({id:Date.now()+i*10,date:iso(d),meal:'Total diario',description:foods[i%foods.length],calcium:base,calories:1450+Math.round(Math.random()*750),createdAt:new Date().toISOString()});
   }
 }
 save();render();showToast('Datos de ejemplo cargados.');
}
function clearData(){
 if(confirm('¿Seguro que quieres borrar todos los registros guardados?')){entries=[];save();render();showToast('Datos eliminados.')}
}
function render(){
 $('todayDate').textContent=new Date().toLocaleDateString('es-MX',{weekday:'long',day:'numeric',month:'long'});
 $('dateInput').value=$('dateInput').value||iso(new Date());
 if(profile.sex) $('sexInput').value=profile.sex;
 if(profile.birth) $('birthInput').value=profile.birth;
 $('goalInput').value=goal;
 if(profile.sex && profile.birth){
   const age=calculateAge(profile.birth), rec=iofCalciumGoal(age,profile.sex);
   $('ageInfo').textContent=`Edad calculada: ${age} años · ${profile.sex==='female'?'Mujer':'Hombre'}.`;
   $('iofRecommendation').style.display='block';
   $('iofRecommendation').textContent=`Meta recomendada: ${fmt(rec)} mg de calcio al día según edad y sexo (tabla IOF / IOM-NAM).${manualOverride?' Meta actual modificada por criterio médico.':''}`;
   if(!manualOverride && rec){goal=rec;localStorage.setItem(GOALKEY,String(goal));$('goalInput').value=goal;}
 }
 renderToday();renderChart();
}
window.addEventListener('resize',()=>renderChart());
render();
initAuth();
</script>
